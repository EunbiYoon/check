# Copy to .env and set HF_TOKEN for gated models (Llama, etc.)
#   cp .env.example .env

CONDA_ENVS_PATH=
CONDA_PKGS_DIRS=
HF_HOME=
HF_HUB_CACHE=${HF_HOME}/hub
HF_TOKEN=
BNB_CUDA_VERSION=126

# Training hyperparameters
STUDENT_MODEL=Qwen/Qwen2.5-3B-Instruct
TEACHER_MODEL=Qwen/Qwen2.5-7B-Instruct

# Algorithm 1 line-2 blind rollout
BLIND_MODEL=Qwen/Qwen2.5-7B-Instruct
BLIND_GPU=0
BLIND_VARIANTS=all
BLIND_GAMES=pd-classic,pd-tight,pd-high-temptation,stag-hunt,bos,matching-pennies,negotiation,auction,ipd-stage
BLIND_EPISODES_PER_COMBINATION=10
BLIND_SEED=random
BLIND_MAX_NEW_TOKENS=384
BLIND_DO_SAMPLE=true
BLIND_TEMPERATURE=0.7
BLIND_OUTPUT_DIR=train/blind-rollout/data

TRAIN_NUM_GPUS=3
# Optional model sharding for one worker, e.g. 0,1,2 (requires TRAIN_NUM_GPUS=1)
TRAIN_VISIBLE_DEVICES=
TRAIN_VARIANTS=filter_on,filter_off,core,aux,all,rw
TRAIN_AUTO_MERGE=true
TRAIN_TRAJECTORY_DIR=
TRAIN_MAX_STEPS=100
# Optional per-variant overrides; blank values fall back to TRAIN_MAX_STEPS.
TRAIN_MAX_STEPS_FILTER_ON=
TRAIN_MAX_STEPS_FILTER_OFF=
TRAIN_MAX_STEPS_CORE=
TRAIN_MAX_STEPS_AUX=
TRAIN_MAX_STEPS_ALL=
TRAIN_MAX_STEPS_RW=
TRAIN_EPOCHS=10
LEARNING_RATE=5e-5
DPO_BETA=0.1
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET=all-linear
MAX_LENGTH=12288
TRAIN_BATCH_SIZE=1
GRAD_ACCUM=8
WARMUP_RATIO=0.05
LR_SCHEDULER=cosine
LOGGING_STEPS=10
SAVE_STEPS=10
SAVE_TOTAL_LIMIT=100
USE_4BIT=true
BNB_4BIT_QUANT_TYPE=nf4
BNB_4BIT_COMPUTE_DTYPE=float16
GRADIENT_CHECKPOINTING=true
FP16=false
BF16=false

# Evaluation hyperparameters
EVAL_EPISODES=12
EVAL_SEED=42
EVAL_MAX_TOKENS=192
EVAL_VARIANTS=base,core
EVAL_GAMES=all
MERGE_ALPHA=0.5
